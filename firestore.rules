rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Reglas para Datos de Usuario (Privado)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Reglas para Nicknames (Público/Compartido)
    match /nicknames/{nickname} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false; 
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 3. Reglas para Proyectos (Colaborativo)
    match /projects/{projectId} {
      // Crear: Permitido si estás autenticado.
      allow create: if request.auth != null;
      
      // Leer: Solo si eres miembro actual
      allow read: if request.auth != null && request.auth.uid in resource.data.membersIds;
      
      // Actualizar: Permitir si eres miembro actual o si te estás uniendo con una invitación pendiente válida
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.membersIds ||
        (
          request.auth.uid in request.resource.data.membersIds &&
          exists(/databases/$(database)/documents/invitations/$(projectId + "_" + request.auth.uid)) &&
          get(/databases/$(database)/documents/invitations/$(projectId + "_" + request.auth.uid)).data.status == "pending"
        )
      );
      
      // Borrar: Solo si eres miembro actual
      allow delete: if request.auth != null && request.auth.uid in resource.data.membersIds;
    }

    // 4. Reglas para Invitaciones
    match /invitations/{invitationId} {
      // Permitir todo a usuarios autenticados por ahora para facilitar flujo
      // (Se puede restringir más validando fromUid/toUid)
      allow read, write: if request.auth != null;
    }

    // 5. Reglas para Notificaciones por Correo (Trigger Email Extension)
    match /mail/{mailId} {
      allow create: if request.auth != null;
    }

    match /mail_queue/{queueId} {
      allow create: if request.auth != null;
    }
  }
}
